# Copy to .env and fill in. Never commit .env.
# Generate secrets with `openssl rand -hex 32`.
# Setting ALLOW_INSECURE_DEFAULTS=1 is for local development only and must not
# be used in production.
#
# All values below are empty or non-secret defaults. `docker compose config`
# and the FastAPI app both refuse to start when required secrets are unset or
# set to a known placeholder.

# --- Secrets (REQUIRED) ---
# Generate: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=

# --- MySQL (MYSQL_ROOT_PASSWORD is used only by the mysql container) ---
# Generate: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
MYSQL_USER=secapp
MYSQL_PASSWORD=
MYSQL_DATABASE=security_dashboard
# Inside the compose network the DB host is the `mysql` service (NOT localhost).
# Use localhost only for a bare-metal local run.
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 1 = use local SQLite (app/data/security.db) instead of MySQL. Explicit opt-in.
USE_SQLITE=0

# --- Elasticsearch (ES_PASSWORD is required by compose) ---
# Host-side ES is reachable from the backend via host.docker.internal.
ES_HOST=
ES_PORT=9200
ES_SCHEME=https
ES_USER=elastic
ES_PASSWORD=
ES_INDEX=security-logs-*
ES_VERIFY_CERTS=false

# --- HTTP / cookies / CORS ---
# Comma-separated allowed browser origins. Empty = same-origin only.
ALLOWED_ORIGINS=http://localhost
# 1 only when a reverse proxy you control overwrites X-Forwarded-For / X-Real-IP
# (the bundled nginx does exactly that, so TRUSTED_PROXY_HEADERS=1 is the
# correct posture behind it). Never enable when clients can reach the API
# directly — those headers are then client-spoofable.
TRUSTED_PROXY_HEADERS=0
# 1 when serving over HTTPS (marks auth cookies Secure).
COOKIE_SECURE=0

# --- JWT / password policy ---
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 480 = 8h).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Refresh token lifetime in days (default 7).
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
ACCESS_COOKIE_NAME=sd_access
REFRESH_COOKIE_NAME=sd_refresh

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Script execution (inspection / blocking) ---
# Scripts run as the app user and are NOT a security sandbox. Disable in
# hardened deployments that do not need them.
ENABLE_SCRIPT_EXECUTION=true
SCRIPT_TIMEOUT_SECONDS=30
SCRIPT_MEMORY_LIMIT_MB=512

# --- Unauthenticated remote ingest (/api/remote/ingest/{name}) ---
INGEST_MAX_BODY_BYTES=1048576
INGEST_RATE_LIMIT_PER_MINUTE=120

# --- Telegram outbound proxy (rule push + the 测试 button) ---
# api.telegram.org is unreachable from some networks (DNS poisoning and/or a
# TLS SNI reset). When that happens the 推送测试 button fails with a
# diagnosis like "TLS 握手被对端重置 ... 典型 SNI 阻断". The fix is an
# outbound proxy, not a code change. Leave empty for direct connection.
# The host is deliberately fixed to api.telegram.org — this proxy is the only
# knob, so it cannot be turned into an SSRF target.
#
# TELEGRAM_PROXY takes precedence over the standard HTTPS_PROXY / ALL_PROXY.
#   TELEGRAM_PROXY=socks5://host.docker.internal:1080
#   TELEGRAM_PROXY=http://host.docker.internal:7890
#   HTTPS_PROXY=http://host.docker.internal:7890
TELEGRAM_PROXY=
HTTPS_PROXY=
ALL_PROXY=

# --- SQLAlchemy connection pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Startup ---
# Seed default system-config rows on boot. Set false to skip.
SEED_SYSTEM_CONFIG=true

# --- Application metadata / debug ---
APP_NAME=Security Dashboard API
APP_VERSION=2.0.0
DEBUG=0

# --- Timezone (compose sets this on the mysql and backend containers) ---
TZ=Asia/Shanghai

# --- Escape hatch (LOCAL DEVELOPMENT ONLY) ---
# Lets the app boot with placeholder secrets and/or an empty MYSQL_PASSWORD.
# The app otherwise refuses to start when SECRET_KEY / JWT_SECRET_KEY are
# missing or set to a known placeholder. Never set this in production.
ALLOW_INSECURE_DEFAULTS=0
