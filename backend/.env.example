# Security Dashboard — 环境变量模板
#
# 复制成 `.env` 后填入真实值。`.env` 已被 .gitignore 排除，**永远不要提交**。
#   cp backend/.env.example backend/.env
#
# 带 `:?` 标注的项在 docker-compose 里是必填：留空会直接启动失败。
# 生产环境 ALLOW_INSECURE_DEFAULTS 必须为 0 —— 置 1 会允许占位密钥，
# 那等于把 JWT 签名密钥公开出去。

# ── 应用 ────────────────────────────────────────────────────────────
APP_NAME=Security Dashboard API
APP_VERSION=2.0.0
DEBUG=0
# 生产必须 0。为 1 时允许占位密钥通过启动校验，仅限测试。
ALLOW_INSECURE_DEFAULTS=0

# ── 密钥（必填）────────────────────────────────────────────────────
# 随机字符串，各 32 字符以上。可用：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# ── JWT / Cookie / 密码策略 ─────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_COOKIE_NAME=sd_access
REFRESH_COOKIE_NAME=sd_refresh
# 仅在 HTTPS 部署时置 1，否则浏览器不会回传 Cookie
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost
# 仅当 API 前面有可信 nginx 时置 1。直接暴露的 API 开这个等于伪造头绕过限流。
TRUSTED_PROXY_HEADERS=0
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── MySQL ───────────────────────────────────────────────────────────
# docker-compose 下 host 必须是服务名 `mysql`，不能写 localhost
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=secapp
MYSQL_PASSWORD=
MYSQL_DATABASE=security_dashboard
# 留给本地调试：置 1 时改用 backend/data/security.db，不连 MySQL
USE_SQLITE=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Elasticsearch ───────────────────────────────────────────────────
# 容器里访问宿主机上的 ES 用 host.docker.internal
ES_HOST=host.docker.internal
ES_PORT=9200
ES_SCHEME=https
ES_USER=elastic
ES_PASSWORD=
ES_INDEX=security-logs-*
ES_VERIFY_CERTS=false

# ── 脚本执行（日常巡检）────────────────────────────────────────────
# 置 false 可整体关停脚本执行能力
ENABLE_SCRIPT_EXECUTION=true
SCRIPT_TIMEOUT_SECONDS=30
SCRIPT_MEMORY_LIMIT_MB=512

# ── 远程接收 ────────────────────────────────────────────────────────
INGEST_MAX_BODY_BYTES=1048576
INGEST_RATE_LIMIT_PER_MINUTE=120

# ── 启动种子 ────────────────────────────────────────────────────────
# 置 false 时启动不再往 system_config 写默认配置。测试里就是 0。
SEED_SYSTEM_CONFIG=true

# ── 数据库 root 密码（仅 docker-compose 的 mysql 服务用）────────────
# 首次初始化后不要改 —— 数据卷里存的是初始化时的哈希，改了会连不上。
MYSQL_ROOT_PASSWORD=
