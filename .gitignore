# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
.venv*/
venv/

# Node
node_modules/
dist/
.npm
.eslintcache

# Environment & Secrets
# .env.example is the committed template — keep it out of this rule.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data (SQLite file, scheduler log) — never commit
backend/app/data/
backend/data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage
htmlcov/
.coverage
.pytest_cache/

# Backup / Debug files (never commit)
*.orig
*.orig2
*.bak
HANDOVER*.md
*_fix_*.md
*_iteration_*.md
*_task_*.md
*COMPLETE*.md
*BASELINE*.md
fixes/
